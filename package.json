{
  "name": "althub-student-connect",
  "version": "0.1.0",
  "private": true,
  "description": "Althub multi-app workspace for server, main app, admin, and super-admin.",
  "workspaces": [
    "Althub-shared",
    "Althub-server",
    "Althub-main",
    "Althub-admin",
    "Althub-super-admin"
  ],
  "scripts": {
    "start": "node start-all.js",
    "start:server": "npm --prefix Althub-server start",
    "start:main": "npm --prefix Althub-main start",
    "start:admin": "npm --prefix Althub-admin start",
    "start:super-admin": "npm --prefix Althub-super-admin start",
    "dev": "node start-all.js",
    "dev:server": "npm --prefix Althub-server run dev",
    "build": "npm run build:all",
    "build:all": "npm run build:main && npm run build:admin && npm run build:super-admin",
    "build:main": "npm --prefix Althub-main run build",
    "build:admin": "npm --prefix Althub-admin run build",
    "build:super-admin": "npm --prefix Althub-super-admin run build",
    "test": "npm run test:server",
    "test:server": "npm --prefix Althub-server test",
    "check:start-script": "node --check start-all.js"
  },
  "engines": {
    "node": ">=18"
  }
}
